# Set to true to use real Firebase Auth instead of the local mock store.
# When false (default), the app uses an in-memory + localStorage store seeded with demo data.
VITE_USE_FIREBASE=false

# Firebase Web App config — required when VITE_USE_FIREBASE=true
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=
