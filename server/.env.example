NODE_ENV=

PORT=3001

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

DATABASE_URL=

# Comma-separated list of every frontend origin that calls auth with cookies.
# Must include the API server origin if you use Swagger on the same host.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

API_BASE_URL=http://localhost:3001

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

JWT_EXPIRES=
JWT_SECRET=
JWT_REFRESH_SECRET=

INIT_SUPER_ADMIN_EMAIL=
INIT_SUPER_ADMIN_PASSWORD=

COMPOSE_PROJECT_NAME=

# Generate with: npx auth secret  (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
